    "@test-evals/llm": "*",
    "better-auth": "1.5.5",
    "dotenv": "^17.2.2",
    "hono": "^4.8.2",
    "zod": "^4.1.13",
    "fuzzysort": "^3.1.0"
  },
  "devDependencies": {
    "@test-evals/config": "*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.21.9",
    "typescript": "^6"
  }
